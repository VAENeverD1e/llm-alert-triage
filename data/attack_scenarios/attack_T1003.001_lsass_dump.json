        "kibana.version": "8.19.13",
        "kibana.alert.rule.parameters": {
            "description": "Detects attempts to access the LSASS (Local Security Authority Subsystem Service) process memory using suspicious access masks or dumping techniques. Attackers often target LSASS to extract cached credentials, enabling lateral movement and privilege escalation. This rule should be investigated promptly, as legitimate software rarely requires direct LSASS memory access.",
            "risk_score": 73,
            "severity": "high",
            "license": "",
            "meta": {
                "kibana_siem_app_url": "http://192.168.31.130:5601/app/security"
            },
            "author": [],
            "false_positives": [],
            "from": "now-6m",
            "rule_id": "052efc44-f956-48cb-971a-25963b66fe86",
            "max_signals": 100,
            "risk_score_mapping": [],
            "severity_mapping": [],
            "threat": [
                {
                    "framework": "MITRE ATT&CK",
                    "tactic": {
                        "id": "TA0006",
                        "name": "Credential Access",
                        "reference": "https://attack.mitre.org/tactics/TA0006/"
                    },
                    "technique": [
                        {
                            "id": "T1003",
                            "name": "OS Credential Dumping",
                            "reference": "https://attack.mitre.org/techniques/T1003/",
                            "subtechnique": []
                        }
                    ]
                }
            ],
            "to": "now",
            "references": [],
            "version": 1,
            "exceptions_list": [],
            "immutable": false,
            "rule_source": {
                "type": "internal"
            },
            "related_integrations": [],
            "required_fields": [],
            "setup": "",
            "type": "query",
            "language": "kuery",
            "index": [
                "apm-*-transaction*",
                "auditbeat-*",
                "endgame-*",
                "filebeat-*",
                "logs-*",
                "packetbeat-*",
                "traces-apm*",
                "winlogbeat-*",
                "-*elastic-cloud-logs-*"
            ],
            "query": "event.code: \"10\" AND\nwinlog.event_data.TargetImage: *lsass.exe AND\nwinlog.event_data.GrantedAccess: (\"0x1fffff\" OR \"0x1010\" OR \"0x1410\" OR \"0x1418\" OR \"0x143a\" OR \"0x1438\") AND\n\nNOT winlog.event_data.SourceImage: (\n    *MsMpEng.exe OR\n    *MsSense.exe OR\n    *SenseCncProxy.exe OR\n    *elastic-agent.exe OR\n    *agentbeat.exe OR\n    *csrss.exe OR\n    *wininit.exe OR\n    *lsass.exe\n) AND\n\nNOT (\n    winlog.event_data.SourceImage: *wmiprvse.exe AND\n    winlog.event_data.CallTrace: (*cimwin32* OR *framedynos*)\n) AND\n\nNOT (\n    winlog.event_data.SourceImage: *svchost.exe AND\n    winlog.event_data.GrantedAccess: \"0x1410\"\n) AND\n\nNOT (\n    winlog.event_data.SourceImage: *taskmgr.exe AND\n    winlog.event_data.GrantedAccess: (\"0x1010\" OR \"0x1410\")\n)",
            "filters": []
        },
