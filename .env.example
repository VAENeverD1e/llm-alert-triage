# =====================================================================
# LLM Alert Triage Environment Variables (.env)
# Copy this template to .env and configure local secret parameters.
# NOTE: .env is in .gitignore and will NEVER be committed to Git.
# =====================================================================

# 1. Webhook Authentication Secret
# Set a shared secret token verified against X-Webhook-Secret or Authorization: Bearer <secret>
WEBHOOK_SECRET=super_secret_soc_token_2026

# 2. Discord Notification Integration
# Paste the live Discord channel incoming webhook URL here (leave empty for dry-run logging)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_DRY_RUN=false
DISCORD_TIMEOUT=5.0
DISCORD_RETRY_COUNT=2

# 3. Elasticsearch & Kibana Connection
# Point to the lab Kibana/Elasticsearch instance (e.g., 192.168.31.130:9200)
ELASTIC_URL=http://192.168.31.130:9200
ELASTIC_API_KEY=
ELASTIC_ALERT_INDEX=.alerts-security.alerts-*

# 4. Local LLM Service (Ollama)
USE_OLLAMA=true
OLLAMA_MODEL=llama3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=30

# 5. Service Network Binding
API_HOST=0.0.0.0
API_PORT=8000
